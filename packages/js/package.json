{
  "name": "refdatakit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "refdatakit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "build": "npm run generate:types && tsc -p tsconfig.json",
    "lint": "eslint src scripts test --max-warnings=0",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate": "npm run build && node dist/cli.js validate ../.."
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
