{
  "name": "@rezwan4029/refdatakit",
  "version": "0.1.3",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Source-aware reference data and validation tools",
  "homepage": "https://github.com/rezwan4029/refdatakit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rezwan4029/refdatakit.git",
    "directory": "packages/js"
  },
  "files": ["dist"],
  "type": "module",
  "bin": {
    "refdatakit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "build": "npm run generate:types && tsc -p tsconfig.json && node scripts/copy-package-assets.mjs",
    "prepack": "npm run build",
    "lint": "eslint src scripts test --max-warnings=0",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate": "npm run build && node dist/cli.js validate ../..",
    "sort": "npm run build && node dist/cli.js sort ../.."
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
