{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Country",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "official_languages"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 code."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "alpha3Code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 3166-1 alpha-3 code, when available."
    },
    "numericCode": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "description": "ISO 3166-1 numeric code, when available."
    },
    "official_languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/languageTag"
      }
    },
    "localizedNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localizedName"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceIds": {
      "$ref": "#/$defs/sourceIds"
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag."
    },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageTag", "name"],
      "properties": {
        "languageTag": {
          "$ref": "#/$defs/languageTag"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    }
  }
}
