{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Country",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "official_languages"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 code."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "alpha3_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "numeric_code": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "official_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "centroid": {
      "$ref": "#/$defs/coordinates",
      "description": "Approximate country-level representative point; not a precise address."
    },
    "localized_names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localized_name"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag."
    },
    "localized_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name"],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  }
}
