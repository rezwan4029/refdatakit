{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "City or Locality",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "country_code"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier that must not be derived from a mutable display name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "subdivision_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "coordinates": {
      "$ref": "#/$defs/coordinates"
    },
    "population": {
      "type": "integer",
      "minimum": 0
    },
    "localized_names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localized_name"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "localized_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name"],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  }
}
