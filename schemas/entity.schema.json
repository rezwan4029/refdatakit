{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Directory Entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "names",
    "entity_type",
    "country_code",
    "city_id",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier that must not be derived from a mutable display name."
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "languages"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{2}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Names keyed by ISO 639-1 code for the entity's official non-English languages."
        }
      }
    },
    "entity_type": {
      "enum": [
        "school",
        "college",
        "university",
        "corporation",
        "civic_organization",
        "religious_building",
        "other"
      ]
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "city_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      },
      "description": "Controlled classifications for an institution; multiple tags may apply."
    },
    "localized_aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localized_alias"
      }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/language"
      },
      "description": "Languages used for instruction, services, or public-facing operations."
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname"
      }
    },
    "external_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/external_id"
      }
    }
  },
  "$defs": {
    "tag": {
      "type": "string",
      "enum": [
        "hospital",
        "k12_school",
        "medical_college",
        "nursing_home",
        "university"
      ],
      "description": "Generated from datasets/manifest.json vocabularies.entity_tags."
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag."
    },
    "localized_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "value"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "external_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "value"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
