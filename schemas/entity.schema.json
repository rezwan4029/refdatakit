{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Directory Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "entityType", "countryCode"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier that must not be derived from a mutable display name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "enum": [
        "school",
        "college",
        "university",
        "corporation",
        "civic_organization",
        "religious_building",
        "other"
      ]
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "subdivisionCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "cityId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "localizedNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localizedName"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/languageTag"
      },
      "description": "Languages used for instruction, services, or public-facing operations."
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname"
      }
    },
    "coordinates": {
      "$ref": "#/$defs/coordinates"
    },
    "externalIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalId"
      }
    },
    "sourceIds": {
      "$ref": "#/$defs/sourceIds"
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag."
    },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageTag", "name"],
      "properties": {
        "languageTag": {
          "$ref": "#/$defs/languageTag"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "externalId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "value"],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    }
  }
}
