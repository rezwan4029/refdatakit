{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefDataKit Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasets"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "license", "retrievedAt", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "License under which this normalized dataset is distributed."
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "path",
        "schema",
        "status",
        "recordCount",
        "sha256",
        "license",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "domain": {
          "enum": ["country", "subdivision", "city", "entity"]
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "path": {
          "type": "string",
          "pattern": "^datasets/.+\\.json$"
        },
        "schema": {
          "type": "string",
          "pattern": "^schemas/[a-z-]+\\.schema\\.json$"
        },
        "status": {
          "enum": ["placeholder", "ready"]
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Distribution license for the normalized dataset, or null for a placeholder."
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "placeholder"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "recordCount": {
                "type": "integer",
                "const": 0
              },
              "license": {
                "type": "null"
              },
              "sources": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "recordCount": {
                "type": "integer",
                "minimum": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
