{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefDataKit Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasets", "vocabularies"],
  "properties": {
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_tags"],
      "properties": {
        "entity_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source_url", "license", "attribution", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^datasets/.+\\.json$"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
