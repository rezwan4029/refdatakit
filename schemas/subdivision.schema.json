{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Administrative Subdivision",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "countryCode", "name", "level"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
      "description": "ISO 3166-2 code when available; otherwise a stable country-scoped code."
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1,
      "description": "Country-specific administrative level, such as state, province, canton, or district."
    },
    "parentCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "localizedNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localizedName"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceIds": {
      "$ref": "#/$defs/sourceIds"
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageTag", "name"],
      "properties": {
        "languageTag": {
          "$ref": "#/$defs/languageTag"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    }
  }
}
