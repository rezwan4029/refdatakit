{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Administrative Subdivision",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "country_code", "name", "level"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
      "description": "ISO 3166-2 code when available; otherwise a stable country-scoped code."
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1,
      "description": "Country-specific administrative level."
    },
    "parent_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "localized_names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localized_name"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "localized_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name"],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
